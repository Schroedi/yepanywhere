# Relay server build
# better-sqlite3 requires build tools for native compilation
FROM node:22-slim

RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.1 --activate

WORKDIR /app

# Copy workspace config, lockfile, and base tsconfig
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./

# Copy only the packages needed for the relay build
COPY packages/shared/package.json packages/shared/
COPY packages/relay/package.json packages/relay/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code for shared and relay
COPY packages/shared/ packages/shared/
COPY packages/relay/ packages/relay/

# Build shared first (relay depends on it), then relay
RUN pnpm --filter @yep-anywhere/shared build && \
    pnpm --filter @yep-anywhere/relay build

ENV NODE_ENV=production
ENV RELAY_PORT=4400
ENV RELAY_DATA_DIR=/data

EXPOSE 4400

CMD ["node", "packages/relay/dist/index.js"]
