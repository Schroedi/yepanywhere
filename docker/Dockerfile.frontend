# Multi-stage build for the remote client (static SPA)
FROM node:22-slim AS builder

# pnpm version comes from package.json "packageManager"
RUN corepack enable

WORKDIR /app

# Copy workspace config, lockfile, and base tsconfig
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY patches/ patches/

# Copy only the packages needed for the client build
COPY packages/shared/package.json packages/shared/
COPY packages/client/package.json packages/client/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/shared/ packages/shared/
COPY packages/client/ packages/client/

# Build shared first, then remote client. Run vite directly instead of
# build:remote: its tsc step type-checks client tests that import server
# sources, which this image does not copy. `pnpm typecheck` covers types.
RUN pnpm --filter @yep-anywhere/shared build && \
    pnpm --filter @yep-anywhere/client exec vite build --config vite.config.remote.ts

# --- Production image: serve static files with nginx ---
FROM nginx:alpine

# Copy built remote client to nginx html root
COPY --from=builder /app/packages/client/dist-remote/ /usr/share/nginx/html/

# Copy nginx config
COPY docker/nginx.selfhost.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
